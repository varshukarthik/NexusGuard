# ---- NovaTech Solutions backend configuration. Copy to backend/.env and adjust. ----
# Never commit a real .env. Secrets are only read server-side; the browser never sees them.

# Database: PostgreSQL + pgvector (recommended). Falls back to SQLite if you point this at sqlite:///...
# Zero-setup default is SQLite; docker-compose overrides this with PostgreSQL + pgvector.
DATABASE_URL=sqlite:///./novatech_demo.db
# DATABASE_URL=postgresql+psycopg://novatech:change-me@localhost:5432/novatech
RESET_DB_ON_START=false

# LLM — leave empty to run the deterministic offline multi-agent engine (demo still works end-to-end).
# Any OpenAI-compatible endpoint works via OPENAI_BASE_URL. Keys are read ONLY by the server.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
USE_OPENAI_EMBEDDINGS=true
EMBEDDING_DIM=384

# Sessions: set a long random value (python -c "import secrets;print(secrets.token_urlsafe(48))")
SESSION_SECRET=change-me
SESSION_TTL_MINUTES=480

# Demo identity switcher + persona sign-in. MUST be false in any real deployment.
DEMO_MODE=true

# Guest Mode ("Continue as Guest") — PUBLIC data only, enforced server-side
GUEST_MODE_ENABLED=true
GUEST_SESSION_TTL_MINUTES=120
GUEST_RATE_LIMIT_PER_MINUTE=6

# Synthetic dataset size multiplier (1.0 ≈ 50k records; 0.25 for quick experiments). Applies on first seed.
SEED_SCALE=1.0

# Rate limits (per session / IP, per minute)
RATE_LIMIT_PER_MINUTE=120
CHAT_RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_MINUTE=10

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COMPANY_TIMEZONE=Asia/Kolkata
